# Copy to .env and fill in values. Do not commit .env.

# Postgres (used by all app services)
POSTGRES_PASSWORD=portfolio

# Kite Connect (stocks, refdata, prices)
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret

# Telegram (telegram service; stocks uses CHAT_ID for outbound)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
CHAT_ID=your_telegram_chat_id

# Logging (app-level; applies to telegram, stocks, prices, refdata)
# LOGS_DIR=logs                   # Directory for log files (default: logs under cwd)
# LOG_RETENTION_COUNT=5           # Max log files to keep per service (default 5)

# Optional
# REFDATA_RUN_ON_START=1          # Run refdata job once on startup
# MARKET_DATA_INTERVAL=60         # Seconds between LTP fetches (default 60)
